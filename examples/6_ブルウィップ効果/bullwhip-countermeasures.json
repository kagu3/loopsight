    {
      "type": "FLOW",
      "name": "卸から小売への出荷",
      "from": "卸の在庫",
      "to": "小売の在庫",
      "behavior": {
        "value": "Min(Delay([小売の発注], [出荷の遅れ], {100 個/Week}), [卸の在庫] / {1 Week})",
        "units": "個/Week"
      },
      "description": "小売の発注が、出荷の遅れのぶんだけ後に届く。1 週に出せるのは、卸にいまある在庫まで"
    },
    {
      "type": "FLOW",
      "name": "工場から卸への出荷",
