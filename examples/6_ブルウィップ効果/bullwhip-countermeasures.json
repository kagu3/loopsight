        "value": "{100 個/Week} + Step({5 Weeks}, {20 個/Week})",
        "units": "個/Week"
      },
      "display": {
        "coordinates": [
          1170,
          260
        ]
      }
    },
    {
      "type": "VARIABLE",
      "name": "予測の期間",
      "description": "受けた注文をならして需要を予測するときの期間。長いほど予測はゆっくり追いつく",
      "behavior": {
        "value": 4,
        "units": "Weeks"
      },
      "display": {
        "interactive": true,
        "interactive_min": 1,
        "interactive_max": 12,
        "coordinates": [
          820,
          -90
        ]
      }
    },
    {
