{
  "engine": "SIMULATION_PACKAGE",
  "name": "ブルックスの法則（遅れたプロジェクトへの増員）",
  "simulation": {
    "algorithm": "RK1",
    "time_start": 0,
    "time_length": 60,
    "time_step": 0.25,
    "time_units": "WEEKS"
  },
  "elements": [
    {
      "type": "STOCK",
      "name": "残りの作業",
      "description": "実際の作業量（タスク）。計画の 1200 より多い",
      "behavior": {
        "initial_value": 1500,
        "non_negative": true
      },
      "display": {
        "coordinates": [
          350,
          100
        ]
      }
    },
    {
      "type": "STOCK",
      "name": "終わった作業",
      "behavior": {
        "initial_value": 0
      },
      "display": {
        "coordinates": [
          750,
          100
        ]
      }
    },
    {
      "type": "STOCK",
      "name": "新人",
      "description": "加わったばかりで、まだ慣れていない人",
      "behavior": {
        "initial_value": 0,
        "non_negative": true
      },
      "display": {
        "coordinates": [
          370,
          420
        ]
      }
    },
    {
      "type": "STOCK",
      "name": "経験者",
      "behavior": {
        "initial_value": 10,
        "non_negative": true
      },
      "display": {
        "coordinates": [
          710,
          420
        ]
      }
    },
    {
      "type": "STOCK",
      "name": "プロジェクトの期間",
      "description": "作業が残っているあいだだけ増える。最終値が終わるまでの週数",
      "behavior": {
        "initial_value": 0
      },
      "display": {
        "coordinates": [
          470,
          20
        ]
      }
    },
    {
      "type": "FLOW",
      "name": "経過",
      "from": null,
      "to": "プロジェクトの期間",
      "behavior": {
        "value": "IfThenElse([残りの作業] > 0.5, 1, 0)"
      },
      "display": {
        "from_coordinates": [
          150,
          40
        ]
      }
    },
    {
      "type": "VARIABLE",
      "name": "標準の生産性",
      "description": "慣れた人 1 人が 1 週に終えるタスク数（意思疎通の手間を除く）",
      "behavior": {
        "value": 5
      },
      "display": {
        "coordinates": [
          450,
          170
        ]
      }
    },
    {
      "type": "VARIABLE",
      "name": "新人の生産性の割合",
      "description": "新人は経験者の何割の仕事ができるか",
      "behavior": {
        "value": 0.3
      },
      "display": {
        "coordinates": [
          380,
          230
        ]
      }
    },
    {
      "type": "VARIABLE",
      "name": "教育に取られる時間",
      "description": "新人 1 人を教えるために、経験者の何人分の時間が取られるか",
      "behavior": {
        "value": 0.25
      },
      "display": {
        "coordinates": [
          380,
          300
        ]
      }
    },
    {
      "type": "VARIABLE",
      "name": "慣れるまでの時間",
      "description": "新人が経験者になるまでの平均（週）",
      "behavior": {
        "value": 8
      },
      "display": {
        "coordinates": [
          530,
          360
        ]
      }
    },
    {
      "type": "VARIABLE",
      "name": "1 組あたりの意思疎通の手間",
      "description": "意思疎通の経路 1 本あたり、全員の時間の何割を使うか",
      "behavior": {
        "value": 0.002
      },
      "display": {
        "coordinates": [
          1080,
          400
        ]
      }
    },
    {
      "type": "VARIABLE",
      "name": "締め切り",
      "description": "週",
      "behavior": {
        "value": 24
      },
      "display": {
        "coordinates": [
          130,
          140
        ]
      }
    },
    {
      "type": "VARIABLE",
      "name": "増員の方針",
      "description": "1 で遅れを取り戻すために人を足す。0 で足さない",
      "behavior": {
        "value": 1
      },
      "display": {
        "interactive": true,
        "interactive_min": 0,
        "interactive_max": 1,
        "coordinates": [
          60,
          560
        ]
      }
    },
    {
      "type": "VARIABLE",
      "name": "人数の上限",
      "behavior": {
        "value": 30
      },
      "display": {
        "coordinates": [
          150,
          650
        ]
      }
    },
    {
      "type": "VARIABLE",
      "name": "採用の時間",
      "description": "足りない人数を何週で埋めるか",
      "behavior": {
        "value": 2
      },
      "display": {
        "coordinates": [
          40,
          400
        ]
      }
    },
    {
      "type": "VARIABLE",
      "name": "全員の人数",
      "behavior": {
        "value": "[新人] + [経験者]"
      },
      "display": {
        "coordinates": [
          300,
          560
        ]
      }
    },
    {
      "type": "VARIABLE",
      "name": "意思疎通の経路の数",
      "description": "n(n-1)/2",
      "behavior": {
        "value": "[全員の人数] * ([全員の人数] - 1) / 2"
      },
      "display": {
        "coordinates": [
          900,
          520
        ]
      }
    },
    {
      "type": "VARIABLE",
      "name": "意思疎通に取られる割合",
      "behavior": {
        "value": "Min(0.9, [意思疎通の経路の数] * [1 組あたりの意思疎通の手間])"
      },
      "display": {
        "coordinates": [
          900,
          300
        ]
      }
    },
    {
      "type": "VARIABLE",
      "name": "実際に働ける人数",
      "description": "経験者に換算した人数。教育と意思疎通の分を引く",
      "behavior": {
        "value": "Max(0, [経験者] - [新人] * [教育に取られる時間] + [新人] * [新人の生産性の割合]) * (1 - [意思疎通に取られる割合])"
      },
      "display": {
        "coordinates": [
          530,
          240
        ]
      }
    },
    {
      "type": "FLOW",
      "name": "作業の進み",
      "from": "残りの作業",
      "to": "終わった作業",
      "behavior": {
        "value": "[実際に働ける人数] * [標準の生産性]",
        "non_negative": true
      }
    },
    {
      "type": "VARIABLE",
      "name": "管理者が考える必要な人数",
      "description": "残りの作業 ÷（残りの週数 × 標準の生産性）。新人の低い生産性や意思疎通の手間を考えない",
      "behavior": {
        "value": "[残りの作業] / (Max([締め切り] - Weeks(), 2) * [標準の生産性])"
      },
      "display": {
        "coordinates": [
          130,
          250
        ]
      }
    },
    {
      "type": "FLOW",
      "name": "採用",
      "from": null,
      "to": "新人",
      "behavior": {
        "value": "IfThenElse([残りの作業] > 0.5, [増員の方針] * Max(0, Min([管理者が考える必要な人数], [人数の上限]) - [全員の人数]) / [採用の時間], 0)"
      },
      "display": {
        "from_coordinates": [
          230,
          440
        ]
      }
    },
    {
      "type": "FLOW",
      "name": "慣れる",
      "from": "新人",
      "to": "経験者",
      "behavior": {
        "value": "[新人] / [慣れるまでの時間]"
      }
    },
