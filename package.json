{
  "name": "loopsight",
  "version": "0.1.0",
  "description": "AI アシスタントと一緒にシステムダイナミクス（SD）のモデルを作り、動かし、確かめるための MCP サーバーとビューア",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "bin": {
    "loopsight": "dist/mcp/index.js",
    "loopsight-viewer": "dist/viewer/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/mcp/index.js",
    "viewer": "node dist/viewer/index.js",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "node scripts/viewer-screenshots.mjs",
    "docs": "npm run build:server && node scripts/tools-reference.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kagu3/loopsight.git"
  },
  "bugs": {
    "url": "https://github.com/kagu3/loopsight/issues"
  },
  "homepage": "https://github.com/kagu3/loopsight#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "simulation": "^9.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
